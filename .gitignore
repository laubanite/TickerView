build/
dist/
installer/Output/
*.manifest
# 沙箱/构建临时目录与备份(本机可直接删)
.tmp/
.piptmp/
backups/
# 图标运行时临时件(pystray 生成的无扩展名临时图标);保留真正的 tray_icon.*
alphaprism/planner/assets/tray_*
!alphaprism/planner/assets/tray_icon.png
!alphaprism/planner/assets/tray_icon.ico

